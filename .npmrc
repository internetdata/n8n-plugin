# The lock records each package by name, version and integrity, without its registry tarball URL.
omit-lockfile-registry-resolved=true
# n8n's packages pull @langchain/community, whose ignore@^7 npm 11 leaves on the hoisted ignore@5 when it
# places peers itself, writing a lock `npm ci` then refuses; peers here come from dependencies alone.
legacy-peer-deps=true
